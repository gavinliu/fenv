#!/usr/bin/env bash
set -eu

if [[ $# != 2 ]]; then
  printf 'Usage: update-definitions <upstream-tags.txt> <ohos-tags.txt>\n' >&2
  exit 1
fi

root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
definitions=$root/share/flutter-build
temp=$(mktemp -d "$definitions/.update.XXXXXX")
trap 'rm -rf -- "$temp"' EXIT

write_tags() {
  local flavor=$1 repo=$2 input=$3
  LC_ALL=C awk -v flavor="$flavor" -v repo="$repo" '
    $2 ~ /^refs\/tags\// && length($1) == 40 && $1 !~ /[^0-9a-f]/ {
      tag = substr($2, 11)
      peeled = sub(/\^\{\}$/, "", tag)
      if (tag !~ /^[0-9]+\.[0-9]+\.[0-9]+([-+][0-9A-Za-z.+-]+)?$/) next
      if (flavor == "ohos" && tag !~ /[-+]ohos(-|$)/) next
      if (peeled || !(tag in commits)) commits[tag] = $1
    }
    END {
      for (tag in commits) printf "%s\t%s\t%s\n", tag, repo, commits[tag]
    }
  ' "$input" > "$temp/$flavor.tsv"
  [[ -s $temp/$flavor.tsv ]] || {
    printf 'No %s version tags found in %s\n' "$flavor" "$input" >&2
    exit 1
  }
}

write_tags upstream https://github.com/flutter/flutter.git "$1"
write_tags ohos https://gitcode.com/CPF-Flutter/flutter_flutter.git "$2"
LC_ALL=C sort "$temp/upstream.tsv" "$temp/ohos.tsv" > "$temp/versions.tsv"
mv -f -- "$temp/versions.tsv" "$definitions/versions.tsv"
